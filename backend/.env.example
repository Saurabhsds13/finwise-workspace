# ============================================
# FinWise Backend - Environment Variables
# ============================================
# Copy this file to .env and update values

# Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database (MySQL - same DB for dev/test/prod)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=finwise
DB_USERNAME=root
DB_PASSWORD=root

# JWT
JWT_SECRET=finwise-dev-secret-key-must-be-at-least-32-bytes-long
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# CORS
CORS_ORIGINS=http://localhost:5173
