# FinWise Backend Environment Variables
# Copy this file to .env and fill in your values

# Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database (only needed for prod profile)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finwise
DB_USERNAME=finwise
DB_PASSWORD=your_password_here

# JWT
JWT_SECRET=your-production-secret-key-must-be-at-least-32-bytes-long
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# CORS
CORS_ORIGINS=http://localhost:5173
